<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ 比对参数设置"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 权重配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="━━━ 综合权重 ━━━"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Cosine -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cosine（整体色调）"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/seekbar_cosine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="35" />
            <TextView
                android:id="@+id/tv_cosine_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="35%"
                android:textColor="#4CAF50"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Histogram -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Histogram（颜色分布）"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/seekbar_histogram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="15" />
            <TextView
                android:id="@+id/tv_histogram_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="15%"
                android:textColor="#2196F3"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- SSIM -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SSIM（纹理结构）"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/seekbar_ssim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50" />
            <TextView
                android:id="@+id/tv_ssim_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#FF9800"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 区域配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="━━━ 截取区域 ━━━"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- X1 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="X 起始 (左边界)" android:textColor="#CCCCCC" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekbar_x1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:max="90" android:progress="25" />
            <TextView android:id="@+id/tv_x1_value" android:layout_width="50dp" android:layout_height="wrap_content"
                android:text="25%" android:textColor="#AAAAAA" android:textSize="14sp" />
        </LinearLayout>

        <!-- X2 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="X 结束 (右边界)" android:textColor="#CCCCCC" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekbar_x2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:max="100" android:progress="75" />
            <TextView android:id="@+id/tv_x2_value" android:layout_width="50dp" android:layout_height="wrap_content"
                android:text="75%" android:textColor="#AAAAAA" android:textSize="14sp" />
        </LinearLayout>

        <!-- Y1 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Y 起始 (上边界)" android:textColor="#CCCCCC" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekbar_y1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:max="90" android:progress="25" />
            <TextView android:id="@+id/tv_y1_value" android:layout_width="50dp" android:layout_height="wrap_content"
                android:text="25%" android:textColor="#AAAAAA" android:textSize="14sp" />
        </LinearLayout>

        <!-- Y2 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Y 结束 (下边界)" android:textColor="#CCCCCC" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekbar_y2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:max="100" android:progress="75" />
            <TextView android:id="@+id/tv_y2_value" android:layout_width="50dp" android:layout_height="wrap_content"
                android:text="75%" android:textColor="#AAAAAA" android:textSize="14sp" />
        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔄 重置"
                android:backgroundTint="#3A3A5E"
                android:textColor="#CCCCCC" />

            <View android:layout_width="16dp" android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾 保存"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
